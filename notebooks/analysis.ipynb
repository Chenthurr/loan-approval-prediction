{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Loan Approval Prediction — Exploratory Analysis\n",
    "\n",
    "This notebook walks through the dataset exploration, model training, and evaluation for the Loan Approval Prediction system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "from model import LoanApprovalModel\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "\n",
    "sns.set_style('darkgrid')\n",
    "plt.rcParams['figure.figsize'] = (10, 6)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load & Explore Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline = LoanApprovalModel()\n",
    "pipeline.load_data(n_samples=10240)\n",
    "pipeline.df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dataset statistics\n",
    "pipeline.df.describe()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Approval distribution\n",
    "approval_rate = pipeline.df['loan_approved'].mean()\n",
    "print(f"Approval rate: {approval_rate:.1%}")\n",
    "\n",
    "pipeline.df['loan_approved'].value_counts().plot(kind='bar', color=['#f85149', '#3fb950'])\n",
    "plt.title('Loan Approval Distribution')\n",
    "plt.xticks([0, 1], ['Rejected', 'Approved'], rotation=0)\n",
    "plt.ylabel('Count')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Feature Distributions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "pipeline.df['credit_score'].hist(bins=40, ax=axes[0,0], color='#58a6ff', alpha=0.7)\n",
    "axes[0,0].set_title('Credit Score Distribution')\n",
    "\n",
    "pipeline.df['annual_income'].hist(bins=40, ax=axes[0,1], color='#3fb950', alpha=0.7)\n",
    "axes[0,1].set_title('Annual Income Distribution')\n",
    "\n",
    "pipeline.df['debt_to_income'].hist(bins=40, ax=axes[1,0], color='#f85149', alpha=0.7)\n",
    "axes[1,0].set_title('Debt-to-Income Distribution')\n",
    "\n",
    "pipeline.df['loan_amount'].hist(bins=40, ax=axes[1,1], color='#a371f7', alpha=0.7)\n",
    "axes[1,1].set_title('Loan Amount Distribution')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Train Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline.preprocess(test_size=0.2)\n",
    "pipeline.train_all()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Evaluate & Compare"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline.evaluate()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Model comparison chart\n",
    "results_df = pd.DataFrame({\n",
    "    k: {sk: sv for sk, sv in v.items() if sk not in ['predictions', 'probabilities']}\n",
    "    for k, v in pipeline.results.items()\n",
    "}).T\n",
    "\n",
    "results_df[['accuracy', 'precision', 'recall', 'f1']].plot(kind='bar', figsize=(10, 6))\n",
    "plt.title('Model Performance Comparison')\n",
    "plt.ylabel('Score')\n",
    "plt.ylim(0, 1)\n",
    "plt.legend(loc='lower right')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Feature Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "rf = pipeline.models['random_forest']\n",
    "importances = rf.feature_importances_\n",
    "indices = np.argsort(importances)[::-1]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.barh(range(len(indices)), importances[indices], align='center', color='#58a6ff')\n",
    "plt.yticks(range(len(indices)), [pipeline.preprocessor.feature_names[i] for i in indices])\n",
    "plt.xlabel('Importance')\n",
    "plt.title('Feature Importance (Random Forest)')\n",
    "plt.gca().invert_yaxis()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Confusion Matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import confusion_matrix\n",
    "import numpy as np\n",
    "\n",
    "cm = confusion_matrix(pipeline.y_test, pipeline.results['random_forest']['predictions'])\n",
    "\n",
    "plt.figure(figsize=(6, 5))\n",
    "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
    "            xticklabels=['Rejected', 'Approved'],\n",
    "            yticklabels=['Rejected', 'Approved'])\n",
    "plt.title('Confusion Matrix — Random Forest')\n",
    "plt.ylabel('Actual')\n",
    "plt.xlabel('Predicted')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. ROC Curves"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import roc_curve\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "for name, res in pipeline.results.items():\n",
    "    fpr, tpr, _ = roc_curve(pipeline.y_test, res['probabilities'])\n",
    "    plt.plot(fpr, tpr, label=f"{name.replace('_', ' ').title()} (AUC={res['auc']:.3f})")\n",
    "\n",
    "plt.plot([0, 1], [0, 1], 'k--', label='Random')\n",
    "plt.xlabel('False Positive Rate')\n",
    "plt.ylabel('True Positive Rate')\n",
    "plt.title('ROC Curves Comparison')\n",
    "plt.legend(loc='lower right')\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Save Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline.save_models()"
   ]
  }
 ],
